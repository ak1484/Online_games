{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "couple_rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "couples": {
      "$coupleId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "members": {
          "$memberUid": {
            ".write": "auth != null && auth.uid === $memberUid"
          }
        },
        "rooms": {
          "$date": {
            "photos": {
              "$photoId": {
                ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid)"
              }
            },
            "comments": {
              "$commentId": {
                ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid)"
              }
            }
          }
        }
      }
    },
    "tot_games": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$gameId": {
        // Allow anyone with valid auth to create new games
        // Only players in the game can modify existing games
        ".write": "auth != null && (data.exists() ? (data.child('player1/id').val() === auth.uid || data.child('player2/id').val() === auth.uid) : true)"
      },
      // Auto-expire old games after 24 hours
      ".validate": "newData.hasChild('createdAt') || !newData.exists()"
    }
  }
}
